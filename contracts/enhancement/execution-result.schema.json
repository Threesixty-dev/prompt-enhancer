{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "evaluator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "metric_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Metric Key",
          "type": "string"
        },
        "operator": {
          "enum": [
            "minimum_value",
            "minimum_delta"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "evaluator_id",
        "metric_key",
        "operator",
        "threshold"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        }
      },
      "required": [
        "assertion",
        "outcome"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "CategoricalTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "categorical",
          "default": "categorical",
          "title": "Kind",
          "type": "string"
        },
        "evaluator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "metric_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Metric Key",
          "type": "string"
        },
        "desired_label": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Desired Label",
          "type": "string"
        }
      },
      "required": [
        "evaluator_id",
        "metric_key",
        "desired_label"
      ],
      "title": "CategoricalTarget",
      "type": "object"
    },
    "CommentaryFinding": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "enum": [
            "goal",
            "scope",
            "context",
            "constraints",
            "acceptance",
            "deliverable",
            "verification",
            "ambiguity",
            "other"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "why": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "suggestion": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "aspect",
        "severity",
        "why",
        "suggestion"
      ],
      "title": "CommentaryFinding",
      "type": "object"
    },
    "ConsumerBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Binding Id",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openhands_acp",
            "inference"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "provider"
      ],
      "title": "ConsumerBinding",
      "type": "object"
    },
    "ContextInference": {
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "enum": [
            "implement",
            "fix",
            "refactor",
            "review",
            "explain",
            "plan",
            "write",
            "test",
            "other"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "pl",
            "mixed",
            "unknown"
          ],
          "title": "Language",
          "type": "string"
        },
        "prompt_chars": {
          "minimum": 0,
          "title": "Prompt Chars",
          "type": "integer"
        },
        "prompt_words": {
          "minimum": 0,
          "title": "Prompt Words",
          "type": "integer"
        },
        "sentence_count": {
          "minimum": 0,
          "title": "Sentence Count",
          "type": "integer"
        },
        "bullet_count": {
          "minimum": 0,
          "title": "Bullet Count",
          "type": "integer"
        },
        "question_count": {
          "minimum": 0,
          "title": "Question Count",
          "type": "integer"
        },
        "file_references": {
          "minimum": 0,
          "title": "File References",
          "type": "integer"
        },
        "code_identifiers": {
          "minimum": 0,
          "title": "Code Identifiers",
          "type": "integer"
        },
        "urls": {
          "minimum": 0,
          "title": "Urls",
          "type": "integer"
        },
        "prior_context_supplied": {
          "minimum": 0,
          "title": "Prior Context Supplied",
          "type": "integer"
        },
        "depends_on_prior_context": {
          "title": "Depends On Prior Context",
          "type": "boolean"
        },
        "verification_requested": {
          "title": "Verification Requested",
          "type": "boolean"
        },
        "missing_elements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Elements",
          "type": "array"
        }
      },
      "required": [
        "task_type",
        "language",
        "prompt_chars",
        "prompt_words",
        "sentence_count",
        "bullet_count",
        "question_count",
        "file_references",
        "code_identifiers",
        "urls",
        "prior_context_supplied",
        "depends_on_prior_context",
        "verification_requested"
      ],
      "title": "ContextInference",
      "type": "object"
    },
    "Delta": {
      "additionalProperties": false,
      "properties": {
        "evaluator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "metric_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Metric Key",
          "type": "string"
        },
        "state": {
          "enum": [
            "comparable",
            "unknown",
            "not_comparable"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "evaluator_id",
        "metric_key",
        "state",
        "reason"
      ],
      "title": "Delta",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "evaluator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "classifier",
            "embedding",
            "rubric",
            "rerank"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "evaluator_id",
        "kind",
        "provenance",
        "metrics"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "EvaluationProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Profile Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Revision",
          "type": "string"
        },
        "evaluators": {
          "items": {
            "$ref": "#/$defs/Evaluator"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evaluators",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "revision",
        "evaluators"
      ],
      "title": "EvaluationProfile",
      "type": "object"
    },
    "Evaluator": {
      "additionalProperties": false,
      "properties": {
        "evaluator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "classifier",
            "embedding",
            "rubric",
            "rerank"
          ],
          "title": "Kind",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Binding Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "rubric": {
          "anyOf": [
            {
              "enum": [
                "task_definition",
                "constraint_precision",
                "acceptance_testability",
                "deliverable_contract"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evaluator_id",
        "kind",
        "binding_id"
      ],
      "title": "Evaluator",
      "type": "object"
    },
    "ExecutionError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Stage",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        }
      },
      "required": [
        "code",
        "stage"
      ],
      "title": "ExecutionError",
      "type": "object"
    },
    "GenerationSettings": {
      "additionalProperties": false,
      "properties": {
        "max_output_chars": {
          "default": 20000,
          "maximum": 20000,
          "minimum": 256,
          "title": "Max Output Chars",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 8192,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "title": "GenerationSettings",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Key",
          "type": "string"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "abstained",
            "execution_error"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "label": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "key",
        "state",
        "reason"
      ],
      "title": "Metric",
      "type": "object"
    },
    "NumericTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "numeric",
          "default": "numeric",
          "title": "Kind",
          "type": "string"
        },
        "evaluator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evaluator Id",
          "type": "string"
        },
        "metric_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Metric Key",
          "type": "string"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease"
          ],
          "title": "Direction",
          "type": "string"
        },
        "desired_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desired Value"
        }
      },
      "required": [
        "evaluator_id",
        "metric_key",
        "direction"
      ],
      "title": "NumericTarget",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "default": "prompt-clarity",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Objective Id",
          "type": "string"
        },
        "revision": {
          "default": "1",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Revision",
          "type": "string"
        },
        "description": {
          "default": "Improve clarity and testability while preserving intent. Mark unavailable details with placeholders.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "targets": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "categorical": "#/$defs/CategoricalTarget",
                "numeric": "#/$defs/NumericTarget"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NumericTarget"
              },
              {
                "$ref": "#/$defs/CategoricalTarget"
              }
            ]
          },
          "maxItems": 16,
          "title": "Targets",
          "type": "array"
        }
      },
      "title": "Objective",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 120,
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "generation": {
          "$ref": "#/$defs/GenerationSettings"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Policy Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Revision",
          "type": "string"
        },
        "instructions": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "instructions"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PromptCue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "detected",
            "missing",
            "counted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        }
      },
      "required": [
        "code",
        "label",
        "status"
      ],
      "title": "PromptCue",
      "type": "object"
    },
    "PromptMetricReading": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "abstained",
            "execution_error"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "higher_is_better": {
          "default": true,
          "title": "Higher Is Better",
          "type": "boolean"
        },
        "explanation_code": {
          "title": "Explanation Code",
          "type": "string"
        },
        "cues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptCue"
          },
          "title": "Cues",
          "type": "array"
        }
      },
      "required": [
        "key",
        "display_name",
        "description",
        "state",
        "explanation_code"
      ],
      "title": "PromptMetricReading",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Provider",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Adapter Version",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "model_license": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model License"
        },
        "tokenizer_revision": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Revision"
        },
        "rubric_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Version"
        },
        "metric_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Version"
        },
        "redactor_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redactor Version"
        },
        "identity_source": {
          "default": "not_applicable",
          "enum": [
            "not_applicable",
            "configured",
            "verified_manifest"
          ],
          "title": "Identity Source",
          "type": "string"
        },
        "reported_model": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
