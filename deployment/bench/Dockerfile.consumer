# Reuse the reviewed OpenHands distribution, then fix the SDK/server versions.
ARG CONSUMER_BASE=ghcr.io/openhands/agent-canvas:1.20.0@sha256:7c3d078f408dbc75233a098b63bb3f3cda475ee5d0024d8b934e148c8f063638
FROM ${CONSUMER_BASE}
ARG CODEX_VERSION=0.156.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends socat && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir openhands-agent-server==1.49.1 openhands-sdk==1.49.1 openhands-tools==1.49.1 \
    && npm install --global "@openai/codex@${CODEX_VERSION}" \
    && command -v codex-acp \
    && mkdir -p /opt/bench-consumer /runtime/consumer \
    && chown openhands:openhands /runtime/consumer \
    && mkdir -p /run/bench-gateway /run/bench-consumer-api \
    && chown openhands:10003 /run/bench-gateway /run/bench-consumer-api \
    && chmod 2770 /run/bench-gateway /run/bench-consumer-api
COPY deployment/bench/consumer_start.py /opt/bench-consumer/start.py
COPY deployment/bench/consumer_retention.py /opt/bench-consumer/consumer_retention.py
USER openhands
WORKDIR /runtime/consumer
ENTRYPOINT ["python3", "/opt/bench-consumer/start.py"]
